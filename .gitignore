*.bak/
*.bak.*/
hermes-agent.bak.*/

# ---------- top-level junk ----------
# ruflo-core plugin (ruvnet/ruflo) writes a redb "ruvector.db" into whatever
# directory a ruflo agent runs from, so it appears scattered across the tree
# (repo root, hermes-agent/, ai_video/comfyui/, ...). Ignore it everywhere, not
# just at known paths.
ruvector.db
/.scratch/
/tmp/
# External-repo clones + downloaded pages staged during integration-sweep recon; scratch only.
/Temp/
# Per-project local task list lives here (exclude/TODO.md) — never committed.
/exclude/
# Arbor autonomous-run session state (qGoal multi-variant backend) — durable run memory, local only.
/.arbor/
# qPlan run workdirs — local only.
/.qplan/
# qGoal run workdirs (done-contract, state, transcript) — local only.
/.qgoal/

# ---------- AI video pipeline (heavy installs, per-machine) ----------
# ComfyUI clone + venv + model weights are too large + machine-specific.
# Only setup_ai_video.ps1, workflows/, MCP servers, and docs are tracked.
/ai_video/comfyui/
/ai_video/models/
/ai_video/add-ons/
/ai_video/start_comfyui.bat
/ai_video/upstream_state.json
/ai_video/.scratch/
# Background-launcher state (start_comfyui_bg.ps1)
/ai_video/.comfyui.pid
/ai_video/.comfyui.log
/ai_video/.comfyui.log.old
/ai_video/.comfyui.err
/ai_video/.comfyui.err.old
# Bundled ffmpeg binaries (downloaded by setup_ai_video.ps1, ~80 MB)
/ai_video/ffmpeg/
# Belt-and-suspenders: ANY safetensors (or other model weights) anywhere
# under /ai_video/, even if a user drops one outside the already-ignored
# /ai_video/comfyui/ subtree. Individual files are 7-30 GB; never commit.
/ai_video/**/*.safetensors
/ai_video/**/*.ckpt
/ai_video/**/*.gguf
/ai_video/**/*.bin
/ai_video/**/*.pth
/ai_video/**/*.pt
/ai_video/**/*.onnx
*.crdownload
*.openai_api_key

# ---------- Crush (charmbracelet/crush) local config + state ----------
# crush.json holds machine-specific provider config (local model paths, env-var
# key refs); the tracked template is crush.json.example. .crush/ is Crush's local
# session/data dir. Never commit these.
/crush.json
/.crush.json
/.crush/

# ---------- per-project Claude Code harness state ----------
/.claude/

# ---------- git worktree checkouts ----------
# Linked worktrees live under .worktrees/<branch>/ — they're independent
# checked-out trees of the same repo, not files we want to track from the
# main tree's perspective. git already special-cases linked worktrees so
# their internals are not staged here, but the directory itself plus any
# per-tree caches (node_modules, .semgrep_cache, etc.) should not show as
# untracked.
/.worktrees/

