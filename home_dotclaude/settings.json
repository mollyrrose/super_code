{
  "env": {
    "OPENAI_API_KEY": "[REDACTED:OPENAI_API_KEY]",
    "DEEPSEEK_API_KEY": "[REDACTED:DEEPSEEK_API_KEY]",
    "QREV_CRITIC_PROVIDERS": "claude,openai,deepseek",
    "ECC_DISABLED_HOOKS": "stop:format-typecheck,pre:edit-write:suggest-compact,pre:observe,pre:observe:continuous-learning,stop:check-console-log,stop:session-end,stop:evaluate-session,stop:cost-tracker,stop:desktop-notify"
  },
  "permissions": {
    "allow": [
      "Agent(*)",
      "Bash(*)",
      "PowerShell(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "ScheduleWakeup(*)",
      "Skill(*)",
      "TaskCreate(*)",
      "TaskUpdate(*)",
      "TaskList(*)",
      "Monitor(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Write(C:\\Users\\[USER]\\.claude\\.qclose_*)",
      "Edit(C:\\Users\\[USER]\\.claude\\.qclose_*)",
      "Write(C:\\Users\\[USER]\\.claude\\skills\\hermes-auto-**)",
      "Edit(C:\\Users\\[USER]\\.claude\\skills\\hermes-auto-**)",
      "Write(C:\\Users\\[USER]\\.claude\\skills\\hermes-auto-*\\**)",
      "Edit(C:\\Users\\[USER]\\.claude\\skills\\hermes-auto-*\\**)",
      "Write(C:/Users/[USER]/.claude/.qclose_*)",
      "Edit(C:/Users/[USER]/.claude/.qclose_*)",
      "Write(C:/Users/[USER]/.claude/skills/hermes-auto-**)",
      "Edit(C:/Users/[USER]/.claude/skills/hermes-auto-**)",
      "Write(C:/Users/[USER]/.claude/skills/hermes-auto-*/**)",
      "Edit(C:/Users/[USER]/.claude/skills/hermes-auto-*/**)",
      "Write(//**/.scratch/qclose_resume_*.md)",
      "Edit(//**/.scratch/qclose_resume_*.md)",
      "Write(//c/Users/[USER]/.claude/.qclose_*)",
      "Edit(//c/Users/[USER]/.claude/.qclose_*)"
    ],
    "deny": []
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"[REPO]\\hermes-agent\\claude_code_integration\\curator_stop_hook.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\banner_stop_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"[REPO]\\hermes-agent\\claude_code_integration\\curator_precompact_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\hook_dispatch.py\" UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\hook_dispatch.py\" PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\rev_learn_sessionend.py\"",
            "timeout": 8,
            "async": true
          },
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\memgraph_sessionend.py\"",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"[PY]\" \"C:\\Users\\[USER]\\.claude\\scripts\\coord_sessionstart_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"C:\\Users\\[USER]\\.claude\\scripts\\statusline_with_weekly.js\"",
    "padding": 0
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "ruflo-core@ruflo": false
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true
}
